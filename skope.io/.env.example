# Copy to .env and fill with your own secret manager values.
# Never commit real credentials.

ALPACA_API_KEY=<your-alpaca-api-key>
ALPACA_API_SECRET=<your-alpaca-api-secret>
ALPACA_IS_PAPER=true

FINNHUB_API_KEY=<your-finnhub-api-key>
GEMINI_API_KEY=<your-gemini-api-key>
GOOGLE_API_KEY=<your-gemini-api-key>

DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

SKOPE_API_TOKEN=<random-long-token>
SKOPE_GEMINI_MODEL=gemini-2.0-flash
SKOPE_MIN_AVG_VOLUME=500000
SKOPE_MIN_DAY_VOLUME=1000000
SKOPE_MIN_RVOL=3.0
SKOPE_MIN_PCT_CHANGE=20.0
SKOPE_POSITION_PCT=0.10
SKOPE_TAKE_PROFIT_PCT=0.10
SKOPE_STOP_LOSS_PCT=0.10
SKOPE_DAILY_LOSS_KILL_PCT=0.10
SKOPE_TIMEZONE=Europe/London

# Dashboard (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TOKEN=<same-as-SKOPE_API_TOKEN>
